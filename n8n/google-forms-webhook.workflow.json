      },
      "id": "Google Forms Webhook",
      "name": "Google Forms Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "google-forms"
    },
    {
      "parameters": {
        "jsCode": "function field(data, names) {\n  const wanted = names.map((name) => name.toLowerCase());\n  const found = Object.entries(data || {}).find(([key]) => wanted.includes(String(key).toLowerCase()));\n  return found ? String(found[1]) : '';\n}\n\nreturn items.map((item) => {\n  const payload = item.json;\n  return {\n    json: {\n      source: 'google',\n      external_id: payload.formId || payload.id || payload.timestamp || new Date().toISOString(),\n      full_name: field(payload, ['full_name', 'name', 'first_name', 'Full Name']),\n      email: field(payload, ['email', 'Email']),\n      phone: field(payload, ['phone_number', 'phone', 'mobile', 'Phone', 'Mobile']),\n      service_requested: field(payload, ['service', 'service_requested', 'Service', 'Service Requested']),\n      message: field(payload, ['message', 'comments', 'details', 'Message', 'Comments', 'Details']),\n      raw_payload: payload,\n      received_at: payload.timestamp || new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "Normalize Google Lead",
      "name": "Normalize Google Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/leads?on_conflict=source,external_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
